    "diff": "^8.0.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.5",
    "openai": "^6.15.0",
    "zod": "^4.3.4"
  },
  "devDependencies": {
    "@types/diff": "^8.0.0",
    "@types/node": "^20.4.2",
    "@typescript-eslint/eslint-plugin": "^6.12.0",
    "@typescript-eslint/parser": "^6.12.0",
    "eslint": "^8.49.0",
    "prisma": "^5.0.0",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.2.2",
    "vitest": "^1.2.5"
